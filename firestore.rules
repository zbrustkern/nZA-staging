rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Users can only read and write their own state
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /progress/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /telemetry_failures/{document} {
      // Anyone authenticated can create a telemetry log
      allow create: if request.auth != null;
      // Anyone authenticated can read for the dashboard (would restrict to admins in prod)
      allow read: if request.auth != null;
    }
  }
}
